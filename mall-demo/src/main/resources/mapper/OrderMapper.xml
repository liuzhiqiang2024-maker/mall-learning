<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.malldemo.mapper.OrderMapper">

    <resultMap id="orderDetailMap" type="com.example.malldemo.dto.OrderDetailVO">
        <!-- 订单本身的字段 -->
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="totalPrice" column="total_price"/>
        <result property="orderStatus" column="order_status"/>
        <result property="createTime" column="create_time"/>

        <!-- 关联出来的商品对象 -->
        <association property="product"
                     javaType="com.example.malldemo.dto.ProductVO"
                     columnPrefix="p_">
            <id property="id" column="id"/>
            <result property="productName" column="product_name"/>
            <result property="price" column="price"/>
        </association>
    </resultMap>
    <select id="selectOrderDetailById" resultMap="orderDetailMap">
        SELECT
            o.id,
            o.user_id,
            o.product_id,
            o.quantity,
            o.total_price,
            o.order_status,
            o.create_time,
            p.id            AS p_id,
            p.product_name  AS p_product_name,
            p.price         AS p_price
        FROM orders o
        LEFT JOIN product p ON o.product_id=p.id
        WHERE o.id=#{orderId}
    </select>

    <!-- 这里放你之前已经写好的所有SQL：根据id查询订单、新增订单等 -->



    <select id="countOrderByUser" resultType="java.lang.Long">
        select count(*) from orders
        where user_id=#{userId}
    </select>
    <select id="selectOrderPageByUser" resultType="Orders">
        select * from orders
        where user_id=#{userId}
        order by id desc
        limit #{offset},#{pageSize}
    </select>


    <!-- 根据id查询订单 -->
    <select id="selectOrderById" resultType="com.example.malldemo.entity.Orders" >
        select id, user_id, product_id, quantity,order_status, total_price, create_time
        from orders
        where id = #{orderId}
    </select>
    <!-- 更新订单状态 -->
    <update id="updateOrderStatus">
        update orders
        set order_status=#{newStatus}
        where id=#{orderId}
    </update>

</mapper>
