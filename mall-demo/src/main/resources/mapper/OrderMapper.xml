<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.malldemo.mapper.OrderMapper">

    <!-- 这里放你之前已经写好的所有SQL：根据id查询订单、新增订单等 -->

    <!-- 统计总数：只有where条件，不要limit！！ -->
    <select id="countOrderPage" resultType="java.lang.Long">
        select count(*) from orders
        <where>
            <if test="query.userId != null">
                user_id = #{query.userId}
            </if>
        </where>
    </select>

    <!-- 分页查询列表：才有limit，三个参数 -->
    <select id="selectOrderPage" resultType="Orders">
        select * from orders
        <where>
            <if test="query.userId != null">
                user_id = #{query.userId}
            </if>
        </where>
        limit #{offset}, #{pageSize}
    </select>
    <!-- 根据id查询订单 -->
    <select id="selectOrderById" resultType="com.example.malldemo.entity.Orders" >
        select id, user_id, product_id, order_status, total_price, create_time
        from orders
        where id = #{orderId}
    </select>
    <!-- 更新订单状态 -->
    <update id="updateOrderStatus">
        update orders
        set order_status=#{newStatus}
        where id=#{orderId}
    </update>

</mapper>
